{
  "name": "painel-wifi-visitantes",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @wifi/api test:e2e",
    "dev": "docker compose run --rm --build seed && pnpm dev:app",
    "dev:app": "pnpm --filter @wifi/shared build && pnpm --parallel --filter @wifi/api --filter @wifi/web dev",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  }
}
